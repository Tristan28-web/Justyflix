# Render Configuration
PORT=10000
DATABASE_FILE=/data/movies.json

# Application Configuration
METADATA_FILE=/data/movies.json
LOG_FILE=/data/logs/app.log

# Scraping Configuration
SCRAPE_INTERVAL_HOURS=6
MAX_RETRIES=3

# MWLBD Configuration (fojik.site is the primary active mirror, mwlbd.com fallback)
MWLBD_BASE_URL=https://fojik.site

# Google Drive Direct Download Flag
GOOGLE_DRIVE_DIRECT=true

# Security
SECRET_KEY=generate_strong_secret_key_here
